# .env (datos que entrega el panel del proveedor en la nube: Aiven > servicio > Overview)
PORT=3006
DB_HOST=mysql-biblioteca-tuusuario.proveedor-nube.com
DB_PORT=<puerto_del_panel>
DB_USER=biblioteca_app
DB_PASSWORD=<clave_del_proveedor>
DB_NAME=biblioteca
DB_SSL=true
DB_SSL_CA=./certs/ca.pem

JWT_SECRET=<genera_tu_clave_aleatoria>
JWT_EXPIRES_IN=1h
